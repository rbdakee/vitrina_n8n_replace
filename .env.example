SD_IVITRINA_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VITRINA_API_BASE=https://vitrina-api.jurta.kz

# Analytics bot (vitrina_ai). Optional: leave the token empty and the bot
# is not started, the ivitrina bot keeps running on its own.
VITRINA_AI_BOT_TOKEN=
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_BEARER_TOKEN=

LOG_LEVEL=INFO
LOG_DIR=/app/logs

# Optional proxy for Telegram API (api.telegram.org). Required when running
# from a network where Telegram is blocked. Supported schemes:
#   http://[user:pass@]host:port
#   https://[user:pass@]host:port
#   socks5://[user:pass@]host:port
TELEGRAM_PROXY=
